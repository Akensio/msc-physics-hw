\begin_layout Standard
Intuition: (a) says that 
\begin_inset Formula $V\cap S$
\end_inset

 is just a deformed open piece of the plane, with nothing torn or glued. (b) says that the two partial derivatives 
\begin_inset Formula $\mathbf{x}_{u},\mathbf{x}_{v}$
\end_inset

 are linearly independent, so 
\begin_inset Formula $S$
\end_inset

 has a tangent plane at every point (no cusps or edges). Note that 
\begin_inset Quotes eld
\end_inset


\begin_inset Formula $\mathbf{x}$
\end_inset

 is differentiable
\begin_inset Quotes erd
\end_inset

 makes sense only because 
\begin_inset Formula $\mathbf{x}$
\end_inset

 takes values in the ambient space 
\begin_inset Formula $\mathbb{R}^{3}$
\end_inset

.
\end_layout

\begin_layout Example
The following are regular surfaces: 
\end_layout

\begin_deeper
\begin_layout Itemize
the sphere 
\begin_inset Formula $S^{2}=\left\{ x^{2}+y^{2}+z^{2}=1\right\} \subset\mathbb{R}^{3}$
\end_inset

 (covered for example by six graphs 
\begin_inset Formula $\mathbf{x}(u,v)=(u,v,\pm\sqrt{1-u^{2}-v^{2}})$
\end_inset

 over the open unit disk, and the analogous ones with the roles of 
\begin_inset Formula $x,y,z$
\end_inset

 exchanged); 
\end_layout

\begin_layout Itemize
the plane 
\begin_inset Formula $\left\{ z=0\right\} $
\end_inset

, with the single parametrization 
\begin_inset Formula $\mathbf{x}(u,v)=(u,v,0)$
\end_inset

; 
\end_layout

\begin_layout Itemize
every plane 
\begin_inset Formula $\left\{ ax+by+cz+d=0\right\} \subset\mathbb{R}^{3}$
\end_inset

 with 
\begin_inset Formula $(a,b,c)\neq(0,0,0)$
\end_inset

. 
\end_layout

\end_deeper
