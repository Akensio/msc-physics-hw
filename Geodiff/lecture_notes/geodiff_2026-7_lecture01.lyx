\begin_inset Formula \[
\mathbf{x}_{\beta}^{-1}\circ\mathbf{x}_{\alpha}:\mathbf{x}_{\alpha}^{-1}(W)\to\mathbf{x}_{\beta}^{-1}(W)\subset\mathbb{R}^{2}
\]
